# ==========================================
# ApexSales CRM - Environment Configuration
# ==========================================

# Port for Node.js Express server (Render automatically sets PORT in production)
PORT=5000

# Node Environment ('production' or 'development')
NODE_ENV=production

# MongoDB Atlas Connection URI
# Leave empty to run on local persistent JSON store (server/data/db.json)
# Or paste your MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/apexsales_crm?retryWrites=true&w=majority
MONGODB_URI=
